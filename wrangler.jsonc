{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chispa",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "durable_objects": {
    "bindings": [
      { "name": "JUEGO", "class_name": "Juego" },
      { "name": "ALMACEN", "class_name": "Almacen" }
    ]
  },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Juego", "Almacen"] } ],
  "vars": { "MAX_PLAYERS": "500", "AI_DAILY_LIMIT": "50", "ANTHROPIC_MODEL": "claude-sonnet-5-5" },
  "observability": { "enabled": true }
}
