{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chispa",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "none", "run_worker_first": ["/", "/index.html", "/privacidad", "/privacidad.html", "/aprender", "/aprender.html", "/grupos", "/grupos.html", "/privacidad-lumbrera", "/privacidad-lumbrera.html", "/jugar", "/jugar.html", "/favicon.ico", "/preguntas", "/preguntas.html", "/preguntas/*", "/google4d510a5713a71d14.html"] },
  "durable_objects": {
    "bindings": [
      { "name": "JUEGO", "class_name": "Juego" },
      { "name": "ALMACEN", "class_name": "Almacen" }
    ]
  },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": ["Juego", "Almacen"] } ],
  "vars": { "MAX_PLAYERS": "500", "AI_DAILY_LIMIT": "50", "ANTHROPIC_MODEL": "claude-sonnet-5-5" },
  "observability": { "enabled": true },
  // Segunda marca con el mismo motor: «Lumbrera» (Biblia y evangelismo). Se publica sola al subir a main (Workers Builds de Cloudflare) o a mano con: npx wrangler deploy --env fe
  "env": {
    "fe": {
      "name": "lumbrera",
      "durable_objects": {
        "bindings": [
          { "name": "JUEGO", "class_name": "Juego" },
          { "name": "ALMACEN", "class_name": "Almacen" }
        ]
      },
      "triggers": { "crons": ["0 * * * *"] },
      "vars": { "MARCA": "fe", "MAX_PLAYERS": "500", "AI_DAILY_LIMIT": "50", "ANTHROPIC_MODEL": "claude-sonnet-5-5" }
    }
  }
}
